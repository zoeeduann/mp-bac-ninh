# Database
DATABASE_URI=postgresql://jingxin:dev@localhost:5432/jingxin

# Payload
PAYLOAD_SECRET=<openssl rand -hex 32>
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Dedicated single-location deployments expose this location at /.
# Production for this repository: bac-ninh
NEXT_PUBLIC_SITE_LOCATION_SLUG=bac-ninh
# GA4 measurement ID for the dedicated Bac Ninh property.
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-0WNPPNKYE4

# Email (Gmail SMTP)
# GMAIL_USER: the network's sending Gmail address.
#   Production value: mindfulpeacecm@gmail.com (registered by the user).
# GMAIL_APP_PASSWORD: 16-char app-specific password from Google Account → Security
#   → 2-Step Verification → App passwords. The Gmail account MUST have 2FA enabled.
# ADMIN_EMAIL: where new-reservation admin notifications go.
# Reply-To headers are set per-booking to the academy's email (chiangmai@…,
# bangkok@…, phuket@…) so visitor replies route to the right academy mailbox
# regardless of the single sending account.
GMAIL_USER=
GMAIL_APP_PASSWORD=
ADMIN_EMAIL=

# Cloudflare R2 (prod only; in dev we use local disk)
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Cloudflare Turnstile
# Disabled for Bac Ninh by default because Cloudflare's challenge host is not
# consistently reachable from mainland China. The form still uses a honeypot,
# same-origin enforcement, and a stricter server-side IP rate limit.
NEXT_PUBLIC_TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Anthropic (translation helper)
ANTHROPIC_API_KEY=

# IndexNow (Bing / participating search engines)
# Default key file is committed at /e32d16a067cca699415242efd714fdff259790c4c5aa40ae27793be4004984ab.txt.
# Leave INDEXNOW_KEY empty to use that default; set a new key only if you also add
# the matching public/{key}.txt file. Localhost submissions are skipped unless
# INDEXNOW_ALLOW_LOCALHOST=true.
INDEXNOW_KEY=
INDEXNOW_DISABLED=
INDEXNOW_ALLOW_LOCALHOST=

# Sentry (optional in dev, recommended for prod)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
