{
  "name": "mindfulpeacebacninh-site",
  "version": "1.0.0",
  "description": "Bilingual Payload CMS + Next.js site for Mindfulpeace Bac Ninh",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" payload generate:importmap && cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "indexnow:submit-sitemap": "tsx scripts/submit-indexnow-sitemap.ts",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "seed": "tsx --tsconfig tsconfig.seed.json --env-file .env.local src/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.0",
    "@payloadcms/db-postgres": "^3.0.0",
    "@payloadcms/next": "^3.0.0",
    "@payloadcms/plugin-form-builder": "^3.0.0",
    "@payloadcms/richtext-lexical": "^3.0.0",
    "@payloadcms/storage-s3": "^3.0.0",
    "@payloadcms/ui": "^3.0.0",
    "@sentry/nextjs": "^8.0.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "autoprefixer": "^10.4.0",
    "cross-env": "^7.0.3",
    "date-fns": "^4.0.0",
    "date-fns-tz": "^3.0.0",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "html-to-image": "^1.11.13",
    "next": "^15.0.0",
    "nodemailer": "^6.9.0",
    "payload": "^3.0.0",
    "postcss": "^8.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "0.34.2",
    "tailwindcss": "^3.4.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@payloadcms/translations": "^3.84.1",
    "@playwright/test": "^1.40.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^6.4.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/ui": "^2.0.0",
    "eslint": "^9.16.0",
    "eslint-config-next": "^15.0.0",
    "eslint-config-prettier": "^9.0.0",
    "happy-dom": "^14.0.0",
    "playwright": "^1.40.0",
    "prettier": "^3.4.2",
    "tsx": "^4.0.0",
    "typescript": "5.7.3",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18.20.2",
    "pnpm": ">=8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "@sentry/cli",
      "unrs-resolver"
    ]
  }
}
